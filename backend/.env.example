# ============================================================
# SIMBA Nusantara — Backend Environment Variables
# Salin file ini menjadi .env pada direktori /backend
# ============================================================

# Supabase Database & Auth Configuration
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS Configuration
# Pisahkan domain yang diizinkan dengan koma tanpa spasi
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.vercel.app
