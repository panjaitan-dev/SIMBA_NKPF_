# ============================================================
# SIMBA Nusantara — Frontend Environment Variables
# Salin file ini menjadi .env.local pada direktori /frontend
# ============================================================

# Supabase Public API Configuration (Client-side)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend REST API Base URL
# Development: http://localhost:5000/api
# Production: https://your-backend-domain.up.railway.app/api atau Render URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
